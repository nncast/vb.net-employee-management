<?xml version="1.0"?>
<configuration>
    <connectionStrings>
        <!-- MySQL connection used by the app. After building, this lives in
             EmployeeManagementSystem.exe.config next to the program: edit the server, port,
             user (Uid) and password (Pwd) there to match your MySQL setup. -->
        <add name="EmployeeDb" connectionString="Server=localhost;Port=3306;Database=dbemployee;Uid=root;Pwd=;" providerName="MySql.Data.MySqlClient"/>
    </connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1"/>
    </startup>
</configuration>
